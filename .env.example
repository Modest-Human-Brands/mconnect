HOSTINGER_EMAIL_BASE_URL=
HOSTINGER_EMAIL_COOKIE=
# Email account OAuth (optional). Redirect URI: <NITRO_PUBLIC_CONNECT_URL>/api/email/accounts/oauth/<google|microsoft>/callback
NITRO_PRIVATE_GOOGLE_CLIENT_ID=
NITRO_PRIVATE_GOOGLE_CLIENT_SECRET=
NITRO_PRIVATE_MICROSOFT_CLIENT_ID=
NITRO_PRIVATE_MICROSOFT_CLIENT_SECRET=

# Shared secret every client must send as the x-api-key header (generate e.g. with: openssl rand -hex 32)
NITRO_PRIVATE_API_KEY=

# Secret for inbound SMS/WhatsApp webhooks that cannot send a header: append ?secret=<value> to the webhook URL
NITRO_PRIVATE_WEBHOOK_SECRET=

# Organization slug for the LiveKit webhook when its URL has no ?org=<slug>
NITRO_PRIVATE_VOICE_ORG_SLUG=
