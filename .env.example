# --- Server ---
NODE_ENV=development
PORT=3001

# --- Notion ---
NOTION_API_KEY=
# JSON map of database ids, e.g. {"contact":"","user":"","interaction":"","telemetry":""}
NITRO_PRIVATE_NOTION_DB_ID=

# --- Public ---
NITRO_PUBLIC_CONNECT_URL=http://localhost:3001

# --- Auth ---
NITRO_PRIVATE_API_KEY=
NITRO_PRIVATE_WEBHOOK_SECRET=

# --- Voice ---
NITRO_PRIVATE_VOICE_ORG_SLUG=

# --- Email account OAuth (optional) ---
# Redirect URI: <NITRO_PUBLIC_CONNECT_URL>/api/email/accounts/oauth/<google|microsoft>/callback
NITRO_PRIVATE_GOOGLE_CLIENT_ID=
NITRO_PRIVATE_GOOGLE_CLIENT_SECRET=
NITRO_PRIVATE_MICROSOFT_CLIENT_ID=
NITRO_PRIVATE_MICROSOFT_CLIENT_SECRET=
