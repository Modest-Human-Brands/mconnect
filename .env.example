# System
PORT=3001
NODE_ENV=development

# Shared (Unprefixed)
NOTION_API_KEY=
NOTION_DB_ID=

# Scoped Service
# JSON map of database ids, e.g. {"contact":"","user":"","interaction":"","telemetry":""}
NITRO_MCONNECT_PUBLIC_CONNECT_URL=http://localhost:3001
NITRO_MCONNECT_PRIVATE_API_KEY=
NITRO_MCONNECT_PRIVATE_WEBHOOK_SECRET=
NITRO_MCONNECT_PRIVATE_VOICE_ORG_SLUG=
# Redirect URI: <NITRO_MCONNECT_PUBLIC_CONNECT_URL>/api/email/accounts/oauth/<google|microsoft>/callback
NITRO_MCONNECT_PRIVATE_GOOGLE_CLIENT_ID=
NITRO_MCONNECT_PRIVATE_GOOGLE_CLIENT_SECRET=
NITRO_MCONNECT_PRIVATE_MICROSOFT_CLIENT_ID=
NITRO_MCONNECT_PRIVATE_MICROSOFT_CLIENT_SECRET=
